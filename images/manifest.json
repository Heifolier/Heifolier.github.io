---
permalink: /images/manifest.json
layout: null
---
{
	"name": {{ site.title | jsonify }},
	"short_name": {{ site.name | jsonify }},
	"description": {{ site.description | jsonify }},
	"start_url": "{{ site.baseurl | default: '/' }}",
	"display": "standalone",
	"lang": {{ site.locale | default: "en" | slice: 0, 2 | jsonify }},
	"icons": [
		{
			"src": "{{ site.baseurl }}/images/favicon-192x192.png",
			"sizes": "192x192",
			"type": "image/png"
		},
		{
			"src": "{{ site.baseurl }}/images/favicon-512x512.png",
			"sizes": "512x512",
			"type": "image/png"
		}
	]
}
